{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan:*)",
      "Bash(composer lint)",
      "Bash(composer analyse)",
      "Bash(composer fix)",
      "Bash(composer check)",
      "Bash(composer test)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/rector:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose up -d)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./storage/app/**)",
      "Bash(php artisan migrate:fresh --env=production:*)",
      "Bash(php artisan db:wipe:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.php) \"$CLAUDE_PROJECT_DIR/vendor/bin/pint\" -q \"$f\" ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
